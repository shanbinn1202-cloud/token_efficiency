#!/bin/bash
# Copy to scripts/env.local.sh and adapt for the cluster. Never commit secrets.
# All sbatch launchers in this repository load this file when it exists. Set
# DRAM_KV_ENV_FILE to use a different environment file.

export DRAM_KV_REPO_ROOT="/path/to/dram-backed-kv"
export VLLM_PYTHON="/path/to/model-env/bin/python"
export MINI_PYTHON="/path/to/swe-bench-env/bin/python"
export DRAM_KV_PYTHON="${VLLM_PYTHON}"
export MODEL_NAME="/path/to/Qwen3.6-27B"
export MODEL_SERVED_NAME="Qwen3.6-27B"
export GOAL_REWRITER_MODEL="/path/to/Qwen3-0.6B"
export AGENT_ROOT="/path/to/agentdiet-unified"

# Hugging Face dataset/model caches and pre-pulled SWE-bench instance images.
# Each image is expected at ${SIF_BASE}/${instance_id}/image.sif.
export HF_HOME="/scratch/$USER/huggingface"
export HF_DATASETS_CACHE="${HF_HOME}/datasets"
export SIF_BASE="/scratch/$USER/apptainer_cache/swebench"
export APPTAINER_CACHEDIR="/scratch/$USER/apptainer_tmp/cache"
export APPTAINER_TMPDIR="/scratch/$USER/apptainer_tmp/work"
export DRAM_KV_OUTPUT_ROOT="/scratch/$USER/results/dram-backed-kv"

# Legacy recorded-trajectory experiments. These are not needed by the
# allocator-only and forward-bridge validations.
export DRAM_KV_LEGACY_REPO="/path/to/snapkv_swe_agent"
export DRAM_KV_TRAJECTORY_13579="/path/to/astropy__astropy-13579.traj.json"
export DRAM_KV_ANNOTATION_13579="/path/to/astropy__astropy-13579.oracle.json"
export DRAM_KV_TRAJECTORY_14995="/path/to/astropy__astropy-14995.traj.json"
export DRAM_KV_ANNOTATION_14995="/path/to/astropy__astropy-14995.oracle.json"
