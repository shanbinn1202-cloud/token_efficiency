# Copy to .env and fill in as needed. .env is git-ignored and must never be committed.

# Optional. Only needed if you point the tau2-bench user-simulator (--user-llm) at an
# external OpenAI-compatible endpoint, or run BFCL categories that call OpenAI. For a
# self-contained run you can instead point the user-simulator at the same local
# mini-sglang server and leave this empty.
OPENAI_API_KEY=

# Optional. Only needed for BFCL web_search_base (live web search via SerpAPI).
# Not needed for multi_turn_base or tau2.
SERPAPI_API_KEY=

# Optional. Path to a local HuggingFace cache (containing hub/models--Org--Name/snapshots/<rev>)
# to reuse already-downloaded weights instead of downloading from the Hub.
# AGENTKV_MODEL_DIR=/path/to/huggingface
