# perf-tb16 tbench environment (generated by build.py from pins.json tbench and tb16-config.json; deployed by deploy_tbench.ps1)
HARBOR_ENV=/home/ubuntu/harbor-env
HARBOR_BIN=/home/ubuntu/harbor-env/bin/harbor
HOST_PYTHON=/usr/bin/python3
TB16_TASK_CACHE=/home/ubuntu/.cache/harbor/tasks/packages/terminal-bench
TB16_MIN_FREE_GB=50
TB16_MIN_MEM_GB=12
TB16_SHARED_LOCKS="swe32=/home/ubuntu/swe32 swe16=/home/ubuntu/swe16 swe10=/home/ubuntu/swe10"
