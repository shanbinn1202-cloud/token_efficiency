+@dataclass(frozen=True, slots=True)
+class ProducerHookBatchResult:
+    processed: tuple[ProducerHookRequestResult, ...]
+    ignored_request_ids: tuple[str, ...]
+    selected_hidden_rows: tuple[int, ...]
