+    return get_page_selection_policy(policy).select(
+        PageSelectionContext(
+            num_pages,
+            fraction,
+            seed,
+            prefix_identity,
+            ranked_logical_pages,
+            query_hash,
+            page_tokens,
+            contract_version,
+            expected_num_pages,
+            expected_page_tokens,
+            expected_selected_count,
+            expected_prefix_identity,
+        )
+    )
